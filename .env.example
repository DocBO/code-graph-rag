REASONING_EFFORT_ORCHESTRATOR=medium
REASONING_EFFORT_CYPHER=medium

# Model Provider Configuration
EMBED_MAX_CHUNK_SIZE=3000

# Example 6: All OpenRouter
ORCHESTRATOR_PROVIDER=openrouter
ORCHESTRATOR_MODEL=openai/gpt-5.6-luna
ORCHESTRATOR_API_KEY=your-open-router-key
ORCHESTRATOR_ENDPOINT=https://openrouter.ai/api/v1

CYPHER_PROVIDER=openrouter
CYPHER_MODEL=deepseek/deepseek-v4-flash-0731
CYPHER_API_KEY=your-open-router-key
CYPHER_ENDPOINT=https://openrouter.ai/api/v1

# Memgraph settings (usually localhost optional external provider + remote Memgraph)
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_HTTP_PORT=7444
LAB_PORT=3000
TARGET_REPO_PATH=.

INGEST_IGNORE_DIRS=.uv-cache,.cache,openspec, tests, .github, .local, .gitmodules, assets, docs, examples, .env, .gitignore, uv.lock, .DS_Store, .pre-commit-config.yaml, out.log, chomedata, .venv, .conda, www, client

# Semantic embedding + Qdrant settings (usually localhost optional external provider + remote Qdrant)
EMBED_ENDPOINT=https://openrouter.ai/api/v1
EMBED_API_KEY=your-open-router-key
EMBED_MODEL=google/gemini-embedding-001  
EMBED_DIMENSION=3072
EMBED_RATE_LIMIT_RPM=60
EMBED_MAX_RETRIES=3
EMBED_RETRY_BACKOFF=2.0
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=120
QDRANT_MAX_RETRIES=5
QDRANT_RETRY_BACKOFF=2.0
QDRANT_UPSERT_BATCH_SIZE=128
